{
  "name": "ciclismo-store",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "prisma generate --schema=./apps/api/src/lib/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./apps/api/src/lib/prisma/schema.prisma",
    "db:seed": "ts-node apps/api/src/seeds/seed.ts",
    "db:studio": "prisma studio --schema=./apps/api/src/lib/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.3",
    "ts-node": "^10.9.1",
    "turbo": "^1.10.16",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next-auth": "^4.24.15",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
