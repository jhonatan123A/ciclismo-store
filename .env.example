# ============================================
# CICLISMO STORE - ENVIRONMENT VARIABLES
# ============================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database (Neon.tech / Supabase)
DATABASE_URL=postgresql://username:password@host/database

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_generate_with_node_crypto
JWT_EXPIRATION=7d

# Admin User (generar hash con bcrypt)
ADMIN_EMAIL=admin@ciclismo-store.com
ADMIN_PASSWORD_HASH=$2a$12$hashed_password_here

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Redis (Upstash)
REDIS_URL=redis://username:password@host:port

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://ciclismo-store.com

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxx